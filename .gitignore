# Raw datasets: ignore by default
datasets/raw/**

# Keep module directories
!datasets/raw/Mod_*/

# Keep structure
!datasets/raw/Mod_*/.gitkeep

# Allow small CSV datasets used in exercises
!datasets/raw/Mod_*/*.csv

# Processed datasets: ignore by default
datasets/processed/**

# Keep module directories
!datasets/processed/Mod_*/

# Keep structure
!datasets/processed/Mod_*/.gitkeep

# Allow small processed files used in exercises
!datasets/processed/Mod_*/*.csv
!datasets/processed/Mod_*/*.xlsx

